{
  "name": "obsidiankit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:seo": "tsx scripts/generate-seo-assets.ts",
    "generate:prerender-routes": "tsx scripts/generate-prerender-routes.ts",
    "build": "npm run generate:prerender-routes && npm run generate:seo && tsc -b && vite build && tsx scripts/generate-static-seo-pages.ts && npm run check:bundle",
    "build:analyze": "cross-env ANALYZE=true npm run build",
    "check:bundle": "node scripts/check-bundle-budgets.mjs",
    "lint": "eslint .",
    "test": "tsx scripts/test-integrity.ts",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@imgly/background-removal": "^1.7.0",
    "@pdfsmaller/pdf-encrypt-lite": "^1.2.0",
    "@types/qrcode": "^1.5.6",
    "browser-image-compression": "2.0.2",
    "docx": "^9.15.4",
    "heic2any": "0.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.73.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.1.0",
    "react-router-dom": "7.18.5",
    "sql-formatter": "^15.9.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}
